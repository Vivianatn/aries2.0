# Copier en `.env` (jamais commité).

# Fichiers GGUF chargés par llama.cpp (dans ./models).
LLM_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
EMBEDDING_MODEL_FILE=bge-m3-q8_0.gguf
# Voix (dans ./models) : Whisper pour comprendre, Piper pour parler.
WHISPER_MODEL_FILE=ggml-small-q5_1.bin
PIPER_VOICE=fr_FR-siwis-medium

# Clé Google AI Studio (https://aistudio.google.com/apikey) : active le chat cloud.
# Vide = modèle local uniquement.
GEMINI_API_KEY=

# Clé interne de SearXNG (obligatoire) : générer avec `openssl rand -hex 32`.
SEARXNG_SECRET=

# Notion : jeton d'intégration (https://www.notion.so/profile/integrations), et secret
# interne entre ArIès et le serveur MCP Notion (`openssl rand -hex 32`).
NOTION_TOKEN=
NOTION_MCP_AUTH_TOKEN=

# Google (Gmail, Agenda) : client OAuth « application de bureau » (Google Cloud Console)
# et adresse du compte utilisé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
